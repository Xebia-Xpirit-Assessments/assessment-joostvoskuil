using './main.bicep'

param location = readEnvironmentVariable('AZURE_LOCATION')
param environment = readEnvironmentVariable('ENVIRONMENT_CODE')
param regionCode = readEnvironmentVariable('REGION_CODE', 'swe')
param serviceName = readEnvironmentVariable('AZD_SERVICE_NAME', 'all')
param containerRegistryName = readEnvironmentVariable('CONTAINER_REGISTRY_NAME')
param postgresAdministratorPassword = readEnvironmentVariable('POSTGRES_ADMINISTRATOR_PASSWORD')
param rabbitMqPassword = readEnvironmentVariable('RABBITMQ_PASSWORD')
param webappExists = bool(readEnvironmentVariable('WEBAPP_EXISTS', 'true'))
param identityApiExists = bool(readEnvironmentVariable('IDENTITY_API_EXISTS', 'true'))
param basketApiExists = bool(readEnvironmentVariable('BASKET_API_EXISTS', 'true'))
param catalogApiExists = bool(readEnvironmentVariable('CATALOG_API_EXISTS', 'true'))
param orderingApiExists = bool(readEnvironmentVariable('ORDERING_API_EXISTS', 'true'))
param healthProbePath = readEnvironmentVariable('HEALTH_PROBE_PATH', '/health')
param livenessProbePath = readEnvironmentVariable('LIVENESS_PROBE_PATH', '/alive')
param healthProbeInitialDelaySeconds = int(readEnvironmentVariable('HEALTH_PROBE_INITIAL_DELAY_SECONDS', '10'))
param healthProbePeriodSeconds = int(readEnvironmentVariable('HEALTH_PROBE_PERIOD_SECONDS', '10'))
param healthProbeTimeoutSeconds = int(readEnvironmentVariable('HEALTH_PROBE_TIMEOUT_SECONDS', '5'))
param healthProbeFailureThreshold = int(readEnvironmentVariable('HEALTH_PROBE_FAILURE_THRESHOLD', '3'))
param webAppMinReplicas = int(readEnvironmentVariable('WEBAPP_MIN_REPLICAS', '1'))
param webAppMaxReplicas = int(readEnvironmentVariable('WEBAPP_MAX_REPLICAS', '1'))
param webAppScaleRules = json(readEnvironmentVariable('WEBAPP_SCALE_RULES', '[]'))
param identityApiMinReplicas = int(readEnvironmentVariable('IDENTITY_API_MIN_REPLICAS', '1'))
param identityApiMaxReplicas = int(readEnvironmentVariable('IDENTITY_API_MAX_REPLICAS', '1'))
param identityApiScaleRules = json(readEnvironmentVariable('IDENTITY_API_SCALE_RULES', '[]'))
param basketApiMinReplicas = int(readEnvironmentVariable('BASKET_API_MIN_REPLICAS', '1'))
param basketApiMaxReplicas = int(readEnvironmentVariable('BASKET_API_MAX_REPLICAS', '1'))
param basketApiScaleRules = json(readEnvironmentVariable('BASKET_API_SCALE_RULES', '[]'))
param catalogApiMinReplicas = int(readEnvironmentVariable('CATALOG_API_MIN_REPLICAS', '1'))
param catalogApiMaxReplicas = int(readEnvironmentVariable('CATALOG_API_MAX_REPLICAS', '1'))
param catalogApiScaleRules = json(readEnvironmentVariable('CATALOG_API_SCALE_RULES', '[]'))
param orderingApiMinReplicas = int(readEnvironmentVariable('ORDERING_API_MIN_REPLICAS', '1'))
param orderingApiMaxReplicas = int(readEnvironmentVariable('ORDERING_API_MAX_REPLICAS', '1'))
param orderingApiScaleRules = json(readEnvironmentVariable('ORDERING_API_SCALE_RULES', '[]'))
