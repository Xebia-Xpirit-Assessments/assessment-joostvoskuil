{
  "name": "eShop .NET 8 Aspire",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {
      "version": "latest",
      "moby": true,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "20"
    }
  },
  "privileged": true,
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [
    5045,
    15888,
    18888,
     19888
  ],
  "portsAttributes": {
    "5045": {
      "label": "eShop web app",
      "onAutoForward": "notify"
    },
    "19888": {
      "label": "Aspire dashboard",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "shd101wyy.markdown-preview-enhanced",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-azuretools.vscode-docker",
        "ms-azuretools.vscode-bicep"
      ],
      "settings": {
        "dotnet.defaultSolution": "eShop.Web.slnf",
        "dotnet.projects.enableAutomaticRestore": false
      }
    }
  },
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "NUGET_XMLDOC_MODE": "skip"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "waitFor": "postCreateCommand"
}
